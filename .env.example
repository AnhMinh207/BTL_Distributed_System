# Generate real values with: python scripts/configure.py
AUTH_SECRET=
SERVICE_KEY=
OPERATIONS_KEY=
DATA_DIR=./runtime
HOST=127.0.0.1
WEB_PORT=8080
WEB_HOST=127.0.0.1
# Optional Photon-compatible geocoder. Public demo is cached and limited to 1 request/second.
GEOCODER_URL=https://photon.komoot.io/api/
# Real OpenStreetMap tiles; no API key. Use only for light interactive demo traffic.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BROKER_URL=http://127.0.0.1:8100
IDENTITY_URL=http://127.0.0.1:8101
DRIVER_URL=http://127.0.0.1:8102
TRIP_URL=http://127.0.0.1:8103
MATCHING_URL=http://127.0.0.1:8104
PAYMENT_URL=http://127.0.0.1:8105
NOTIFICATION_URL=http://127.0.0.1:8106
PRICING_URL=http://127.0.0.1:8107
OBSERVABILITY_URL=http://127.0.0.1:8108
DYNAMIC_PRICING=1
CIRCUIT_BREAKER=1
CIRCUIT_THRESHOLD=3
CIRCUIT_COOLDOWN=2
# Matching replicas must each own a separate local DB namespace.
MATCHING_REPLICA_DATA=1
MAX_ATTEMPTS=5
LEASE_SECONDS=3
SAGA_TIMEOUT=60
OFFER_TIMEOUT=120
TOKEN_TTL=3600
